# Template for stacks/backup/secrets.enc.env, which is committed *encrypted*.
# Create it with:  make secrets FILE=stacks/backup/secrets.enc.env
# `make sync` decrypts it to /srv/platform/backup/.env at 0600; run.sh sources it.

# The scoped `hub-backup` Spaces key created by terraform/backup.tf — deliberately
# not the account-level key that authenticates the state backend. Get the values
# with `terraform output -raw backup_access_key_id` / `backup_secret_access_key`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESTIC_REPOSITORY=s3:https://sgp1.digitaloceanspaces.com/personal-hub-backups

# No recovery path: this encrypts every backup in Spaces. Store it in your
# password manager, separate from the backups it protects.
RESTIC_PASSWORD=
