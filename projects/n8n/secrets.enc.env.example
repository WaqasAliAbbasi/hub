# Template for projects/n8n/secrets.enc.env, which is committed *encrypted*.
# Create it with:  make secrets FILE=projects/n8n/secrets.enc.env
# Deploying it is just `git push` — the workflow decrypts it to /srv/n8n/.env
# at 0600 before starting the container, which reads it via env_file.

# Encrypts credentials n8n stores at rest, in ./data/database.sqlite.
# Generate with: openssl rand -base64 32
#
# The nightly backup only walks /srv/*/data, so this key is never in a backup —
# which is what keeps a stolen backup useless, and also means losing it makes a
# restored database unreadable. Changing it orphans every stored credential.
N8N_ENCRYPTION_KEY=
