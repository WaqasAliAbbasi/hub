# Template for terraform/secrets.enc.env, which is committed *encrypted*.
# Create it with:  make secrets FILE=terraform/secrets.enc.env
# The Makefile feeds these to every terraform command via `sops exec-env`, so
# there is nothing to `source` and no terraform.tfvars to keep in sync.

# Account-level DigitalOcean Spaces key (DO console -> API -> Spaces Keys).
# Same pair under two names: the s3 state backend only reads AWS_*, the
# digitalocean provider only reads TF_VAR_*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TF_VAR_spaces_access_id=
TF_VAR_spaces_secret_key=

TF_VAR_hcloud_token=
TF_VAR_digitalocean_token=

# Optional, both have defaults — see terraform/variables.tf.
# TF_VAR_ssh_public_key=ssh-ed25519 AAAA...
# TF_VAR_ssh_allowed_ips=["203.0.113.4/32"]
